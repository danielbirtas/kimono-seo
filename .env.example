########################################################################
# Kimono SEO — Environment Variables (.env.example)
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# This app is self-hosted: you bring your OWN API keys and credentials.
# See docs/CONFIGURATION.md for where to obtain each key and how to
# connect each integration (Shopify, Anthropic, Google, DataForSEO, ...).
#
# Legend:
#   [REQUIRED]  app will not work correctly without it
#   [OPTIONAL]  feature-specific; the related feature is disabled/degraded
#               if unset. A safe default is noted where one exists.
#
# NEVER commit your real .env or paste real secrets. All values below
# are obvious placeholders.
########################################################################


# ─────────────────────────────────────────────────────────────────────
# Core / App
# ─────────────────────────────────────────────────────────────────────

# [OPTIONAL] Node runtime environment. When set to "test", the auth
# rate-limiter cleanup interval is skipped. Use "production" when
# deploying. Default: unset (behaves like development).
NODE_ENV=production

# [OPTIONAL] HTTP port for the React Router server. Default: 3000.
PORT=3000

# [REQUIRED in practice] Public base URL of THIS app. Used to build:
#   - email verify/reset links (auth emails)
#   - GSC / GA4 OAuth redirect URIs (see *_callback routes below)
# Must be the externally reachable HTTPS URL of your deployment.
# Code default if unset: http://localhost:3000 (do NOT rely on it in production).
APP_URL=https://seo.example.com

# [OPTIONAL] Alternate public base URL. Used as the base for the Bing
# (/bing-callback) and Pinterest (/pinterest-callback) OAuth redirect
# URIs, and as a fallback for GSC/GA4 when APP_URL is unset.
# If you use Bing or Pinterest OAuth, set this to the same value as APP_URL.
# Code fallback if unset: http://localhost:3000
SHOPIFY_APP_URL=https://seo.example.com

# [OPTIONAL] Shopify app "handle" (slug). Used only when constructing a
# fallback GA4 callback URL. Default: kimono-ultimate-seo.
SHOPIFY_APP_HANDLE=your-app-handle


# ─────────────────────────────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ─────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string used by Prisma as the datasource.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# For managed Postgres that only exposes 443, use the provider's pooled/
# SSL endpoint (e.g. append ?sslmode=require).
DATABASE_URL=postgresql://user:changeme@localhost:5432/kimono_seo?schema=public


# ─────────────────────────────────────────────────────────────────────
# Auth / Session
# ─────────────────────────────────────────────────────────────────────
# NOTE: Sessions are DB-backed. The `kimono_session` cookie stores an
# opaque DB token (UserSession.token); it is NOT a signed/encrypted
# cookie, so there is no cookie-signing secret to configure here.
#
# SESSION_SECRET is present in ecosystem.config.cjs for legacy reasons
# but is NOT read anywhere in the application code. You may omit it.
# SESSION_SECRET=changeme-not-used-by-app

# Seeded SUPER_ADMIN account (created by `npm run seed`, prisma/seed.js).
# Change these before seeding a production database, then log in and
# change the password again from the UI.

# [OPTIONAL] Admin email. Default: admin@kimonogroup.ro
# ADMIN_EMAIL=admin@example.com

# [OPTIONAL] Admin password (bcrypt-hashed at seed time).
# Default: KimonoSEO2026!  — CHANGE THIS.
# ADMIN_PASSWORD=changeme-strong-password

# [OPTIONAL] Admin display name. Default: Kimono Admin
# ADMIN_NAME=Site Admin


# ─────────────────────────────────────────────────────────────────────
# Email / SMTP (nodemailer)
# Used for account verification, password reset, and weekly digest email.
# Auth is only added when BOTH SMTP_USER and SMTP_PASS are set.
# ─────────────────────────────────────────────────────────────────────

# [OPTIONAL] SMTP host. Default: 127.0.0.1
SMTP_HOST=smtp.example.com

# [OPTIONAL] SMTP port. Default: 25.
#   465 => secure TLS. 25 => STARTTLS with tls.rejectUnauthorized=false.
SMTP_PORT=587

# [OPTIONAL] SMTP username. If set together with SMTP_PASS, auth is enabled.
SMTP_USER=apikey-or-username

# [OPTIONAL] SMTP password.
SMTP_PASS=changeme

# [OPTIONAL] From address for outbound email.
# Default: Kimono SEO <noreply@kimonogroup.ro>
SMTP_FROM=Kimono SEO <noreply@example.com>


# ─────────────────────────────────────────────────────────────────────
# Cron / Background job runner
# ─────────────────────────────────────────────────────────────────────

# [REQUIRED for background jobs] Shared secret compared against the
# X-Cron-Secret header (or ?s= query on some routes) to authorize the
# self-triggering SEO job runner and scheduled cron endpoints, e.g.:
#   /api/seo/job-runner, /api/seo/kick, /api/seo/reconcile,
#   /api/seo/cron/monitor, /api/cleanup, /api/ai-citations/runner,
#   /api/pinterest/scheduled-runner
# WARNING: if unset, the guard compares against an empty string, so a
# request with an empty/missing header would pass. ALWAYS set a strong
# random value in production, e.g.  openssl rand -hex 32
CRON_SECRET=changeme-long-random-cron-secret


# ─────────────────────────────────────────────────────────────────────
# AI — Anthropic Claude (primary) + OpenAI (ChatGPT citation measurement)
# ─────────────────────────────────────────────────────────────────────

# [REQUIRED for AI features] Anthropic API key (x-api-key). Powers keyword
# discovery, taxonomy, tagging, audits, article/schema generation, GEO,
# image alt-text (Vision), llms.txt, etc. AI steps throw/skip if unset.
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxx

# [OPTIONAL] Claude model id for "quality"/large tasks.
# Default: claude-sonnet-4-6
AI_MODEL_QUALITY=claude-sonnet-4-6

# [OPTIONAL] Claude model id for "fast"/cheap tasks.
# Default: claude-haiku-4-5-20251001
AI_MODEL_FAST=claude-haiku-4-5-20251001

# [OPTIONAL] OpenAI API key. Only used to measure ChatGPT brand citations
# in the AI-Citations module. If unset, ChatGPT measurement is disabled
# (other platforms/Claude still work). Get one at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxx

# [OPTIONAL] OpenAI model id for ChatGPT citation measurement.
# Default: gpt-4o
AI_MODEL_OPENAI=gpt-4o


# ─────────────────────────────────────────────────────────────────────
# Shopify — OAuth install + Admin API + offline token refresh
# ─────────────────────────────────────────────────────────────────────
# There are TWO client id/secret pairs referenced in code:
#   SHOPIFY_CLIENT_ID/SECRET  -> the one-click OAuth install/callback flow
#   SHOPIFY_API_KEY/SECRET    -> background offline access-token refresh
# For a single Shopify app, set BOTH pairs to the SAME app credentials.
#
# The OAuth install route derives the callback URL from APP_URL:
#   ${APP_URL}/api/shopify-oauth/callback
# Just set APP_URL to your own domain and register that URL as an Allowed
# redirection URL in the Shopify app. See docs/CONFIGURATION.md.

# [REQUIRED for Shopify OAuth] Shopify app client_id (API key).
SHOPIFY_CLIENT_ID=your-shopify-client-id

# [REQUIRED for Shopify OAuth] Shopify app client_secret. Also used for
# HMAC verification of the OAuth callback.
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# [REQUIRED for background token refresh] Shopify app client id, used by
# the offline session/token refresh helper for background jobs.
SHOPIFY_API_KEY=your-shopify-client-id

# [REQUIRED for background token refresh] Shopify app client secret.
SHOPIFY_API_SECRET=your-shopify-client-secret

# [OPTIONAL] Shopify Admin API version override. NOTE: most modules
# hardcode "2025-04" in their request URLs, so this is not consistently
# honored. Leave unset unless you know you need it.
SHOPIFY_API_VERSION=2025-04


# ─────────────────────────────────────────────────────────────────────
# Google — Search Console (GSC), Analytics 4 (GA4), PageSpeed
# ─────────────────────────────────────────────────────────────────────
# The app uses TWO Google OAuth client references:
#   GSC_CLIENT_ID/SECRET      -> GSC, GA4, crawl-budget token flows
#   GOOGLE_CLIENT_ID/SECRET   -> GSC-based redirect scan / GA4 token refresh
# You can create ONE Google OAuth client and set both pairs to it.
# Redirect URIs the code builds (register ALL that you use):
#   {APP_URL}/gsc-callback     (Search Console)
#   {APP_URL}/ga4-callback     (Analytics 4)

# [REQUIRED for GSC/GA4/crawl-budget] Google OAuth client ID.
GSC_CLIENT_ID=xxxx.apps.googleusercontent.com

# [REQUIRED for GSC/GA4/crawl-budget] Google OAuth client secret.
GSC_CLIENT_SECRET=GOCSPX-xxxx

# [REQUIRED for GSC redirect scan / GA4 token refresh] Google OAuth
# client ID (may be the same client as GSC_CLIENT_ID).
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# [REQUIRED for GSC redirect scan / GA4 token refresh] Google OAuth
# client secret (may be the same as GSC_CLIENT_SECRET).
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# [OPTIONAL] Google PageSpeed Insights API key for Core Web Vitals audits.
# Works keyless but is rate-limited; a key raises your quota.
# Get one at: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=your-pagespeed-api-key


# ─────────────────────────────────────────────────────────────────────
# DataForSEO — keyword enrichment + People-Also-Ask
# ─────────────────────────────────────────────────────────────────────
# HTTP Basic auth (login:password). If unset, ENRICH and PAA steps
# are skipped/no-op (the app falls back to AI where possible).
# Get credentials at: https://app.dataforseo.com/

# [OPTIONAL] DataForSEO account login (email).
DATAFORSEO_LOGIN=you@example.com

# [OPTIONAL] DataForSEO account password / API password.
DATAFORSEO_PASSWORD=changeme


# ─────────────────────────────────────────────────────────────────────
# Bing Webmaster (Microsoft Entra OAuth)
# ─────────────────────────────────────────────────────────────────────
# Redirect URI the code builds:  {SHOPIFY_APP_URL}/bing-callback
# OAuth is gated by isBingConfigured() (needs both id + secret).

# [OPTIONAL] Microsoft Entra app client ID for Bing Webmaster OAuth.
BING_OAUTH_CLIENT_ID=your-entra-app-client-id

# [OPTIONAL] Microsoft Entra app client secret for Bing Webmaster OAuth.
BING_OAUTH_CLIENT_SECRET=your-entra-app-client-secret

# [OPTIONAL] Legacy Bing API key. Used only as a presence flag on the
# dashboard ("Bing configured"). The per-store Bing API key is stored in
# the DB (SeoSetting), not here. Safe to leave unset.
BING_API_KEY=your-bing-api-key


# ─────────────────────────────────────────────────────────────────────
# Pinterest (API v5 OAuth)
# ─────────────────────────────────────────────────────────────────────
# Redirect URI the code builds:  {SHOPIFY_APP_URL}/pinterest-callback
# OAuth is gated by isPinterestConfigured() (needs both id + secret).

# [OPTIONAL] Pinterest app client ID.
PINTEREST_CLIENT_ID=your-pinterest-app-id

# [OPTIONAL] Pinterest app client secret.
PINTEREST_CLIENT_SECRET=your-pinterest-app-secret


# ─────────────────────────────────────────────────────────────────────
# WooCommerce (partial support) — NO env vars
# ─────────────────────────────────────────────────────────────────────
# WooCommerce is connected per-store from the UI. The REST API
# consumer key + secret are stored in the database as
# "consumer_key:consumer_secret" (StoreConnection.accessToken), NOT here.
# See docs/CONFIGURATION.md for how to generate the keys in WooCommerce.


# ─────────────────────────────────────────────────────────────────────
# IndexNow — NO env vars
# ─────────────────────────────────────────────────────────────────────
# The IndexNow key is self-generated per store and stored in the DB
# (SeoSetting.seo_indexnow_key), then served at /{key}.txt. Nothing to
# configure here.


# ─────────────────────────────────────────────────────────────────────
# Billing — NO env vars
# ─────────────────────────────────────────────────────────────────────
# This app has NO payment processor wired. Plans are a static catalog
# used only for feature-gating (app/lib/billing.js) plus a User-plan
# system (TRIAL/STARTER/GROWTH/AGENCY/ADMIN). There is no Stripe/checkout,
# so there are no billing environment variables.

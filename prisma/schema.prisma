model FanOutSession {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  primaryKeyword  String
  status          String   @default("pending")
  queries         String   @default("[]") @db.Text
  totalQueries    Int      @default(0)
  coveredCount    Int      @default(0)
  errorMessage    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId, createdAt(sort: Desc)])
}

model SeoAuthor {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name         String
  role         String?
  bio          String?  @db.Text
  avatarUrl    String?

  wikipediaUrl String?
  wikidataQid  String?
  linkedinUrl  String?
  twitterUrl   String?
  websiteUrl   String?

  credentials  String   @default("[]") @db.Text
  isDefault    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model ScheduledPin {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  scheduledFor  DateTime
  status        String    @default("pending")

  boardId       String
  boardName     String?
  imageUrl      String    @db.Text
  title         String    @db.Text
  description   String    @db.Text
  altText       String?   @db.Text
  link          String    @db.Text

  source        String    @default("manual")
  productId     String?
  productTitle  String?

  pinterestPinId String?
  errorMessage   String?  @db.Text
  attempts       Int      @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  postedAt      DateTime?

  @@index([storeId, status, scheduledFor])
  @@index([status, scheduledFor])
}

model WebhookDedupe {
  id           String   @id
  topic        String?
  shopDomain   String?
  processedAt  DateTime @default(now())

  @@index([processedAt])
}

model AiBrandConfig {
  id          String   @id @default(cuid())
  storeId     String   @unique
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  brandName   String
  aliases     String   @default("[]")
  domains     String   @default("[]")
  competitors String   @default("[]")

  scheduleFrequency      String   @default("off")
  scheduleRunsPerPrompt  Int      @default(3)
  lastScheduledScanAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiPrompt {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  text        String   @db.Text
  intent      String?
  cluster     String?
  status      String   @default("active")
  source      String   @default("manual")

  textHash    String

  createdAt   DateTime @default(now())
  lastRunAt   DateTime?
  runs        AiCitationRun[]

  @@unique([storeId, textHash])
  @@index([storeId, status])
}

model AiCitationScan {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status       String   @default("RUNNING")
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  platforms    String   @default("[]")
  runsPerPrompt Int     @default(3)
  promptCount  Int      @default(0)

  totalRuns    Int      @default(0)
  totalCitations Int    @default(0)
  brandMentions Int     @default(0)
  brandCitationRate Float?
  costCents    Int      @default(0)
  errorMessage String?

  runs         AiCitationRun[]

  @@index([storeId, startedAt])
}

model AiCitationRun {
  id           String   @id @default(cuid())
  scanId       String
  scan         AiCitationScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  promptId     String
  prompt       AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  platform     String
  model        String?
  runIndex     Int      @default(0)

  rawResponse  Json
  responseText String   @db.Text

  brandMentioned Boolean @default(false)
  brandPosition Int?
  mentionCount Int      @default(0)
  competitorsMentioned String @default("[]")

  costCents    Int      @default(0)
  durationMs   Int?
  errorMessage String?

  citations    AiCitation[]
  ranAt        DateTime @default(now())

  @@index([scanId, platform])
  @@index([promptId, platform, runIndex])
}

model AiCitation {
  id           String   @id @default(cuid())
  runId        String
  run          AiCitationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  url          String   @db.Text
  domain       String
  title        String?  @db.Text
  position     Int?
  isBrandOwned Boolean  @default(false)
  snippetText  String?  @db.Text

  createdAt    DateTime @default(now())

  @@index([runId])
  @@index([domain])
}

model SeoAlert {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type         String
  severity     String
  subjectKind  String?
  subjectId    String?

  title        String
  description  String   @db.Text
  metadata     Json     @default("{}")

  status       String   @default("open")
  ignoredUntil DateTime?
  resolvedAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId, status, severity])
  @@index([storeId, type, status])
  @@index([storeId, subjectKind, subjectId])
}

model SeoDecisionLog {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  decisionKind String
  subjectKind  String?
  subjectId    String?

  inputs       Json
  output       Json
  rationale    String?  @db.Text

  supersededBy String?
  decidedBy    String   @default("auto_v1")

  createdAt    DateTime @default(now())

  @@index([storeId, decisionKind, createdAt])
  @@index([storeId, subjectKind, subjectId])
}

model SeoAiExtractCache {
  id           String   @id @default(cuid())
  clusterHash  String   @unique
  sampleTitle  String
  language     String   @default("ro")
  candidates   Json
  aiModel      String
  hitCount     Int      @default(0)
  promptHash   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime

  @@index([clusterHash])
  @@index([expiresAt])
}

model SeoGscData {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId    String
  pageUrl      String
  query        String

  impressions  Int      @default(0)
  clicks       Int      @default(0)
  position     Float    @default(0)
  ctr          Float    @default(0)

  dateRangeStart DateTime
  dateRangeEnd   DateTime
  syncedAt       DateTime @default(now())

  @@unique([storeId, pageUrl, query, dateRangeStart])
  @@index([storeId, productId])
  @@index([storeId, pageUrl])
  @@index([storeId, syncedAt])
}
